<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ResetCodeActivity"
    android:background="@drawable/gradient_background">

    <!-- Heading for Verification Code -->
    <TextView
        android:id="@+id/reset_code_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verification Code"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="48dp"
        android:textColor="#0B0B0B"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Input field for Code -->
    <EditText
        android:id="@+id/reset_code_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:autofillHints="true"
        android:hint="Enter Code"
        android:inputType="number"
        android:layout_marginTop="24dp"
        android:padding="12dp"
        android:minHeight="48dp"
        android:layout_marginHorizontal="32dp"
        android:textColorHint="#CCCCCC"
        android:background="@drawable/rounded_input_background"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/reset_code_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Verify Button -->
    <Button
        android:id="@+id/verify_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Verify"
        android:layout_marginTop="24dp"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_button_background"
        android:padding="12dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/reset_code_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />


    <TextView
        android:id="@+id/errorTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#0D0D0D"
        android:visibility="gone"
        android:text="@string/error_message_here"
        android:textSize="14sp"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>
